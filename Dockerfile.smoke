# Smoke test: verify that the workspace compiles and links against ONNX Runtime
# 1.6.0 with the TensorRT EP disabled and a prebuilt CPU ORT (no multi-hour
# source build).
#
# This branch targets aarch64/Jetson. The smoke test runs on x86_64 with
# -DYOLO_VENDOR_ALLOW_NON_AARCH64=ON purely to validate the code; it is NOT a
# deployable image.
#
#   docker build -f Dockerfile.smoke -t yolo_ros_smoke .
#
# The ROS distro is an ARG so the same file can target another distro:
#   docker build -f Dockerfile.smoke --build-arg ROS_DISTRO=humble -t yolo_ros_smoke .
ARG ROS_DISTRO=galactic
FROM ros:${ROS_DISTRO}-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ARG ONNXRUNTIME_VERSION=1.6.0
ARG ONNXRUNTIME_URL=https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/onnxruntime-linux-x64-${ONNXRUNTIME_VERSION}.tgz

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git curl ca-certificates \
      libcurl4-openssl-dev libssl-dev \
      python3-colcon-common-extensions \
      ros-${ROS_DISTRO}-ament-cmake-gtest \
      ros-${ROS_DISTRO}-ament-index-cpp \
      ros-${ROS_DISTRO}-cv-bridge \
      ros-${ROS_DISTRO}-rclcpp-lifecycle \
      ros-${ROS_DISTRO}-rosidl-default-generators \
      ros-${ROS_DISTRO}-rosidl-default-runtime \
      ros-${ROS_DISTRO}-sensor-msgs \
      ros-${ROS_DISTRO}-std-srvs \
      ros-${ROS_DISTRO}-visualization-msgs \
      ros-${ROS_DISTRO}-message-filters \
      ros-${ROS_DISTRO}-tf2-ros \
      ros-${ROS_DISTRO}-geometry-msgs \
    && rm -rf /var/lib/apt/lists/*

# Prebuilt CPU ONNX Runtime 1.6.0 (x64): no source build needed for the smoke.
RUN mkdir -p /opt/ort160 \
    && curl -sSL "${ONNXRUNTIME_URL}" | tar xz -C /opt/ort160 --strip-components=1 \
    && test -f /opt/ort160/lib/libonnxruntime.so

WORKDIR /ws
COPY . /ws/src/yolov8_ros/

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && colcon build --symlink-install --packages-up-to yolo_ros \
         --cmake-args \
           -DYOLO_ORT_USE_TENSORRT=OFF \
           -DYOLO_VENDOR_ALLOW_NON_AARCH64=ON \
           -DONNXRUNTIME_ROOT=/opt/ort160 \
           -DBUILD_TESTING=OFF

# Prove the executables were produced.
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && . /ws/install/setup.sh \
    && ros2 pkg executables yolo_ros
